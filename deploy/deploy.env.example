# Deployment settings for THIS installation.
#
# Copy this file to deploy.env (git-ignored) and fill in your own values:
#
#     cp deploy/deploy.env.example deploy/deploy.env
#
# deploy.sh sources deploy.env if it exists; anything exported in the shell
# takes the same names and works too.

# SSH target that serves the built files.
CT_HOST=192.0.2.10
CT_USER=root
# Private key authorised on that host. `$HOME` and `~` are expanded.
KEY=$HOME/.ssh/id_ed25519_example

# Hostname the vhost answers to. Leave it as `_` to answer on any name.
SERVER_NAME=_

# Path where dist/ lands on the target, and the name of the nginx site.
WEBROOT=/var/www/crochet-letters
SITE=crochet-letters
